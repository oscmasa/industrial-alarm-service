ALARM_APP_NAME="Industrial Alarm Service"
ALARM_DOCS_ENABLED=true

# Docker Compose settings. Defaults are for local development only.
API_PORT=8000
FRONTEND_PORT=8080
POSTGRES_DB=alarms
POSTGRES_USER=alarm_user
POSTGRES_PASSWORD=local_dev_password

# Inside Compose, use the db hostname. URL-encode special characters in credentials.
# If POSTGRES_* changes, update this URL to match.
ALARM_DATABASE_URL=postgresql+psycopg://alarm_user:local_dev_password@db:5432/alarms
