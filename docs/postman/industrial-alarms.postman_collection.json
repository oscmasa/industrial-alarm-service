    {
      "name": "Overview - two-day comparison",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/metrics/overview?start_time=2026-09-29T00:00:00-05:00&end_time=2026-10-01T00:00:00-05:00",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "metrics",
            "overview"
          ],
          "query": [
            {
              "key": "start_time",
              "value": "2026-09-29T00:00:00-05:00"
            },
            {
              "key": "end_time",
              "value": "2026-10-01T00:00:00-05:00"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Overview aggregates and comparison agree with daily counts\", function () {",
              " const body = pm.response.json();",
              " pm.expect(body.daily.length).to.eql(2);",
              " pm.expect(body.daily.map(x => x.date)).to.eql([\"2026-09-29\", \"2026-09-30\"]);",
              " pm.expect(body.total_events).to.eql(body.daily.reduce((sum,x) => sum+x.event_count,0));",
              " pm.expect(Object.values(body.severity_counts).reduce((sum,x) => sum+x,0)).to.eql(body.total_events);",
              " pm.expect(Date.parse(body.comparison.start_time)).to.eql(Date.parse(\"2026-09-27T00:00:00-05:00\"));",
              " pm.expect(Date.parse(body.comparison.end_time)).to.eql(Date.parse(\"2026-09-29T00:00:00-05:00\"));",
              " if (body.comparison.event_count > 0) pm.expect(Number(body.comparison.change_percent)).to.be.closeTo((body.total_events-body.comparison.event_count)*100/body.comparison.event_count,0.011);",
              "});"
            ]
          }
        }
      ]
    },
