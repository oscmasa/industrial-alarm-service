{
  "info": {
    "name": "Industrial Alarm Service",
    "description": "Ten read-only requests demonstrating service status, pagination, filters, top tags and input validation. Select the local environment and run the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Service status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "status"
          ],
          "query": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Service returns 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Service is running\", function () { pm.expect(pm.response.json()).to.eql({status: \"ok\"}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Alarm list - first page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alarms?page=1&page_size=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alarms"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Alarm query returns 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Pagination and filters are respected\", function () {",
              "  const body = pm.response.json();",
              "  const query = Object.fromEntries(Object.entries(pm.request.url.query.toObject()).map(function (entry) { return [entry[0], decodeURIComponent(String(entry[1]))]; }));",
              "  pm.expect(body.items).to.be.an(\"array\");",
              "  pm.expect(body.pagination.page).to.eql(Number(query.page || 1));",
              "  pm.expect(body.pagination.page_size).to.eql(Number(query.page_size || 50));",
              "  pm.expect(body.pagination.total).to.be.at.least(0);",
              "  pm.expect(body.items.length).to.be.at.most(body.pagination.page_size);",
              "  body.items.forEach(function (alarm) {",
              "    pm.expect(alarm.event_id).to.match(/^EVT-[0-9]{8}$/);",
              "    if (query.severity) pm.expect(alarm.severity).to.eql(query.severity);",
              "    if (query.tag) pm.expect(alarm.tag).to.eql(query.tag.trim().toUpperCase());",
              "    if (query.start_time) pm.expect(Date.parse(alarm.occurred_at)).to.be.at.least(Date.parse(query.start_time));",
              "    if (query.end_time) pm.expect(Date.parse(alarm.occurred_at)).to.be.below(Date.parse(query.end_time));",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
