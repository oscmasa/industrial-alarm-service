    {
      "name": "Top tags - limit 5",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/metrics/top-tags?limit=5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "metrics",
            "top-tags"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Metrics return 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Top tags respect the limit and ranking\", function () {",
              "  const body = pm.response.json();",
              "  const limit = Number(pm.request.url.query.toObject().limit || 10);",
              "  pm.expect(body.items).to.be.an(\"array\");",
              "  pm.expect(body.limit).to.eql(limit);",
              "  pm.expect(body.items.length).to.be.at.most(limit);",
              "  body.items.forEach(function (item, index) {",
              "    pm.expect(item.tag).to.be.a(\"string\");",
              "    pm.expect(item.event_count).to.be.above(0);",
              "    if (index > 0) pm.expect(body.items[index - 1].event_count).to.be.at.least(item.event_count);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
